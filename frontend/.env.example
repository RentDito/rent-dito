VITE_API_BASE_URL=http://localhost:4000

# Supabase browser client (Task 1, Step 6). Every VITE_ value is compiled into
# the bundle and is readable by anyone, so only the publishable key belongs
# here. The service-role and sb_secret_ keys are server-only and must never
# appear in this file or any Vercel frontend variable.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
