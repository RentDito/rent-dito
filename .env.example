# Workspace defaults for local development. Keep real credentials in untracked .env files.
NODE_ENV=development
PORT=4000
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Domain for the synthetic internal addresses backing each Supabase Auth user.
# RentDito accounts have no email; this only satisfies Auth's email-keyed password
# grant. `.invalid` is RFC 6761 reserved and never resolves, so these addresses
# can never receive mail. Use a distinct value per environment.
AUTH_IDENTIFIER_DOMAIN=auth.local.rentdito.invalid
FEATURE_ACCOUNTS=false
FEATURE_MARKETPLACE=false
FEATURE_LISTING_AUTHORING=false
FEATURE_LISTING_MODERATION=false
FEATURE_SAVED_INQUIRIES=false
FEATURE_TENANCY_INVITATIONS=false
FEATURE_TENANT_BILLING=false
FEATURE_PAYMENT_PROOFS=false
FEATURE_LANDLORD_OPERATIONS=false
VITE_API_BASE_URL=http://localhost:4000
